+    #[test]
+    fn disconnect_preserves_configured_peer_identity_but_clears_learned_identity() {
+        let peer = PeerId::random();
+        let other = PeerId::random();
+        let address: Multiaddr = format!("/ip4/127.0.0.1/tcp/26000/p2p/{peer}").parse().unwrap();
+        let mut registry = Registry::default();
+        let mut config = Config::new(false);
+        config.persistent_peers_only = true;
+        let mut discovery = Discovery::<dummy::Behaviour>::new(config, vec![address.clone()], &mut registry);
+        assert!(discovery.is_persistent_peer(&peer));
+        discovery.cleanup_peer_on_disconnect(peer);
+        assert_eq!(discovery.get_peer_id_for_addr(&address), Some(peer));
+        assert!(discovery.is_persistent_peer(&peer));
+        assert!(!discovery.is_persistent_peer(&other));
+        discovery.cleanup_peer_on_disconnect(peer);
+        assert!(discovery.is_persistent_peer(&peer));
+
+        let address: Multiaddr = "/ip4/127.0.0.1/tcp/26001".parse().unwrap();
+        let mut discovery = Discovery::<dummy::Behaviour>::new(config, vec![address.clone()], &mut registry);
+        discovery.bootstrap_nodes[0].0 = Some(peer);
+        discovery.cleanup_peer_on_disconnect(peer);
+        assert_eq!(discovery.get_peer_id_for_addr(&address), None);
+        assert!(!discovery.is_persistent_peer(&peer));
+    }
